# ==============================================================================
# CloudForge DevOps - Backend Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and fill in your actual values.
# DO NOT commit the actual '.env' file containing real secrets to git.

# FastAPI Application Config
ENVIRONMENT=development
PROJECT_NAME="CloudForge DevOps API"

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=cloudforge

# Database URL for native local running (uncomment and override if not using Docker)
# DATABASE_URL=postgresql://postgres:secure_password_here@localhost:5432/cloudforge

# Redis Configuration (for Celery background tasks if enabled)
REDIS_URL=redis://localhost:6379/0

# GitHub Integration
# Required for analyzing private repositories or to avoid GitHub API rate limits.
# Generate a token with 'repo' scope at https://github.com/settings/tokens
GITHUB_TOKEN=your_personal_access_token_here
